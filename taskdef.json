
{
  "family": "aws-cicd-capstone",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": arn:aws:iam::325657596892:role/ecsTaskExecutionRole,
  "containerDefinitions": [
    {
      "name": "aws-cicd-capstone",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
